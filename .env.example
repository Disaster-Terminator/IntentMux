# IntentMux runtime example.
#
# Copy this file to an untracked .env or export the variables in your process
# manager. Do not put real secrets in git.

# Runtime root for user-owned config, semantic assets, logs, health reports,
# and local review artifacts. The default local path is the repository-internal
# ignored .intentmux-home directory. Production deployments may point this at an
# explicit persistent path outside the source checkout.
#
# For local process runs, leaving ROUTER_CONFIG unset and setting INTENTMUX_HOME
# makes IntentMux read $INTENTMUX_HOME/config/routes.yaml. Initialize the
# default ignored home with:
#   uv run python scripts/init_runtime_home.py
INTENTMUX_HOME=./.intentmux-home

# Optional explicit router config. This takes precedence over INTENTMUX_HOME.
# ROUTER_CONFIG=./.intentmux-home/config/routes.yaml

# IntentMux listener.
ROUTER_HOST=127.0.0.1
ROUTER_PORT=4001

# OpenAI-compatible upstream. In LiteLLM-first deployments this is usually
# LiteLLM. Provider routing, fallback, credentials, budgets, and model pools
# should remain upstream-owned.
ROUTER_LITELLM_BASE_URL=http://127.0.0.1:4000
ROUTER_LITELLM_TIMEOUT=120
ROUTER_LITELLM_API_KEY=

# Optional IntentMux inbound key. This protects direct calls to IntentMux and
# is separate from upstream and embedding credentials.
ROUTER_INBOUND_API_KEY=

# Embedding upstream.
ROUTER_EMBEDDING_URL=http://127.0.0.1:1234/v1/embeddings
ROUTER_EMBEDDING_MODEL=text-embedding-jina-embeddings-v5-text-small-retrieval@q8_0
ROUTER_EMBEDDING_API_KEY=
ROUTER_EMBEDDING_HEADERS_JSON=
# Static route-bank embedding cache. When unset, load_settings defaults to
# $INTENTMUX_HOME/cache/route-embeddings.json or ./.intentmux-home/cache/route-embeddings.json.
ROUTER_ROUTE_EMBEDDING_CACHE_ENABLED=true
# ROUTER_ROUTE_EMBEDDING_CACHE_PATH=./.intentmux-home/cache/route-embeddings.json

# Logs. If these are unset and INTENTMUX_HOME is set, IntentMux defaults to:
#   $INTENTMUX_HOME/logs/routes
#   $INTENTMUX_HOME/logs/prompts
ROUTER_AUDIT_LOG_ENABLED=true
ROUTER_AUDIT_LOG_TIMEZONE=Asia/Shanghai
# ROUTER_AUDIT_LOG_DIR=./.intentmux-home/logs/routes

# Prompt review logs are local-only supplemental evidence for review. Keep off
# in public or untrusted deployments. raw_local records prompt text.
ROUTER_PROMPT_LOG_MODE=off
# ROUTER_PROMPT_LOG_DIR=./.intentmux-home/logs/prompts
ROUTER_PROMPT_LOG_MAX_CHARS=20000

# Daily health / external scheduler inputs. Schedulers such as cron, systemd
# timers, CI, or private ops agents should call repository scripts; their job
# IDs, notification targets, and wrapper paths remain outside this repository.
INTENTMUX_LOG_DIR=./.intentmux-home/logs
INTENTMUX_ROUTER_BASE_URL=http://127.0.0.1:4001
INTENTMUX_LITELLM_BASE_URL=http://127.0.0.1:4000
INTENTMUX_LOG_CONTAINER=intentmux
INTENTMUX_MIN_ROUTE_RECORDS=0
INTENTMUX_TIMEZONE=Asia/Shanghai
